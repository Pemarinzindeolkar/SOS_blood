# Copy this file to .env.local and fill it in. On Render, set these in the
# service's Environment tab instead (render.yaml sets DATABASE_URL for you).

# Local Postgres, or a cloud one. Cloud databases usually need SSL, so add
# ?sslmode=require to the end of their external URL.
DATABASE_URL=postgres://localhost:5432/blood_sos

# Public address of the site, used in the links inside emails/SMS.
# Not needed on Render (it uses RENDER_EXTERNAL_URL), unless you add a custom domain.
APP_URL=http://localhost:3000

# Email via SMTP. Without it, emails are skipped (printed to the console in development).
# For Gmail: host smtp.gmail.com, port 587, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Blood SOS <no-reply@bloodsos.local>"

# SMS via Twilio. Without it, SMS are skipped (printed to the console in development).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
